# Copy this file to .env for local development.
# Set these as Environment Variables in the Render dashboard for production.

# Database (DreamHost MySQL)
DB_HOST=mysql.pythonmoney.com
DB_NAME=ucc_records
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Stripe — get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create products in Stripe Dashboard first, then paste IDs here
STRIPE_PRICE_SEARCH_MONTHLY=price_...
STRIPE_PRICE_SEARCH_YEARLY=price_...
STRIPE_PRICE_BULK_MONTHLY=price_...
STRIPE_PRICE_BULK_YEARLY=price_...
STRIPE_PRICE_BOTH_MONTHLY=price_...
STRIPE_PRICE_BOTH_YEARLY=price_...

# Frontend URL (used for Stripe redirect URLs)
FRONTEND_URL=https://uccdata.yddconsulting.com
